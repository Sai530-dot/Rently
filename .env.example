# For local Django development, copy the needed values into backend/.env.
# Do not place GEMINI_API_KEY in frontend/.env or prefix it with REACT_APP_.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000
# DATABASE_URL=postgresql://user:password@host:5432/reelty
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Reelty <no-reply@example.com>
# Server-only credentials for grounded Location Insights. Do not use REACT_APP_
# prefixes for either value and do not commit real keys.
# GEOAPIFY_API_KEY=your-server-geoapify-key
# GEMINI_API_KEY=your-gemini-api-key
# LOCATION_INSIGHTS_CACHE_SECONDS=3600
# LOCATION_INSIGHTS_HTTP_TIMEOUT_SECONDS=10
