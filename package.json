{
  "name": "reelty-project",
  "version": "1.0.0",
  "description": "Reelty - Property Management Platform",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
