{
  "name": "reelty-project",
  "version": "1.0.0",
  "description": "Reelty - Property Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend/src && python manage.py runserver 0.0.0.0:8000",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "install:all": "npm --prefix frontend install",
    "clean": "rm -rf node_modules frontend/node_modules frontend/build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}


